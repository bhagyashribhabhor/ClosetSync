<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Outfit Planner 👗"
            android:textColor="#7652A8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create and save your perfect outfit"
            android:textColor="#777777"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <EditText
            android:id="@+id/etOutfitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Outfit Name"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Top (T-shirt / Shirt / Kurti)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bottom (Jeans / Trousers / Skirt)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etShoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shoes"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/etOccasion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Occasion (College / Party / Casual)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveOutfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Outfit 👗"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:padding="14dp"
            app:backgroundTint="#7652A8"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>