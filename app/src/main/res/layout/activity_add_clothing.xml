<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Clothing 👕"
            android:textColor="#7652A8"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etClothingName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="Clothing Name"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Category (Shirt, Jeans, Dress...)"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etColor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Color"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etSeason"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Season (Summer, Winter...)"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etOccasion"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Occasion (Casual, Party...)"
            android:padding="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveClothing"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:text="SAVE CLOTHING"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7652A8"
            app:cornerRadius="18dp"/>

    </LinearLayout>

</ScrollView>