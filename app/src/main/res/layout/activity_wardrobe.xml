<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF7FF"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Wardrobe 👗"
        android:textColor="#7652A8"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Organize your clothes and plan your outfits."
        android:textColor="#666666"
        android:textSize="16sp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddClothing"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="25dp"
        android:text="+  Add Clothing"
        android:textSize="17sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7652A8"
        app:cornerRadius="18dp"/>

    <TextView
        android:id="@+id/tvWardrobeItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Your wardrobe is empty 👚&#10;&#10;Add your first clothing item to start."
        android:textColor="#777777"
        android:textSize="18sp"/>

</LinearLayout>